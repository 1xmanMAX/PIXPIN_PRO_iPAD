<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- El buzon que comparten la app, la extension de Compartir y los
	     widgets (Sistema/BuzonCompartido.swift). Hay que darlo de alta en
	     la cuenta de Apple al firmar; la CI compila sin firmar. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.io.github.1xmanmax.pixpin</string>
	</array>
</dict>
</plist>
